{
  // ───────────────────────────────────────────────────────────────────────
  //  omarchy-favorites — your curated app list.
  //
  //  Edit this file, then run ./generate.sh
  //
  //  Each app is a desktop id (the .desktop filename without the suffix).
  //  Find ids with:   ls /usr/share/applications ~/.local/share/applications
  //
  //  An entry can be a plain id, or an object to customise it:
  //     "chromium"
  //     { "app": "chromium", "label": "Browser" }
  //     { "label": "Apple Music", "exec": "omarchy-shell shell toggle x.y" }
  // ───────────────────────────────────────────────────────────────────────

  "groups": [
    {
      "label": "Daily",
      "apps": [
        { "app": "com.mitchellh.ghostty", "label": "Ghostty" },
        { "app": "chromium",              "label": "Chromium" },
        { "app": "org.gnome.Nautilus",    "label": "Files" },
        { "app": "nvim",                  "label": "Neovim" },
        { "app": "obsidian",              "label": "Obsidian" }
      ]
    },
    {
      "label": "Comms & Media",
      "apps": [
        { "app": "Discord", "label": "Discord" },
        { "app": "Zoom",    "label": "Zoom" },
        { "app": "YouTube", "label": "YouTube" },
        { "label": "Apple Music", "icon": "multimedia-audio-player", "exec": "omarchy-shell shell toggle melonamin.apple-music" },
        { "app": "mpv",     "label": "Media Player" }
      ]
    },
    {
      "label": "Games",
      "apps": [
        { "app": "runelite",      "label": "RuneLite" },
        { "app": "bolt-launcher", "label": "Bolt Launcher" }
      ]
    },
    {
      "label": "Work",
      "apps": [
        { "app": "Docker",                        "label": "Docker" },
        { "app": "libreoffice-writer",            "label": "Writer" },
        { "app": "libreoffice-calc",              "label": "Calc" },
        { "app": "libreoffice-impress",           "label": "Impress" },
        { "app": "omawrite",                      "label": "Omawrite" },
        { "app": "com.github.xournalpp.xournalpp","label": "Xournal++" }
      ]
    },
    {
      "label": "Creative",
      "apps": [
        { "app": "com.github.PintaProject.Pinta", "label": "Pinta" },
        { "app": "org.kde.kdenlive",              "label": "Kdenlive" },
        { "app": "omacut",                        "label": "Omacut" },
        { "app": "com.obsproject.Studio",         "label": "OBS Studio" }
      ]
    },
    {
      "label": "Utility",
      "apps": [
        { "app": "localsend", "label": "LocalSend" }
      ]
    }
  ]

}
