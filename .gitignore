# Never commit secrets or machine/session state
*.bak
*.bak.*
*.log
*.sock
*.pid
.DS_Store

# Browser / app profiles and session data
**/Default/
**/chromium/
**/WidevineCdm/

# Keys & credentials — belt and braces
*.key
*.pem
id_*
known_hosts
.netrc
**/gh/hosts.yml

# Private calendar feed addresses (cal-sync)
cal-sync/feeds.conf

# Calendar-to-profile map for link-router (has account emails)
link-router/profiles.conf

# Herdr writes these into every mod folder on start
config/herdr-app/mods/*/gpui-kit.d.ts
config/herdr-app/mods/*/jsconfig.json
