# Which Chrome profile a calendar's meetings open in.
# Left side: any part of the OmaCal account email, feed URL, or calendar name.
# First match wins. Right side: Personal, Archway, CAVA or TRF.
you@gmail.com = Personal
@yourcompany.com = Archway
outlook.office365.com/owa/calendar/<cava-feed-id> = CAVA
