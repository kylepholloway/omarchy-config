#!/usr/bin/env python3
"""Default handler for https links: meeting links open in the right Chrome profile.

OmaCal, Slack and everything else hand https links to xdg-open, which runs this.
  1. A Zoom / Meet / Teams / Webex link that belongs to an event in OmaCal (or the
     cal-sync cache) opens in the Chrome profile of the calendar it came from.
  2. Any other Zoom link goes through webapp-profile zoom-join (profile picker,
     or a company Zoom domain mapped in webapp-profile).
  3. Sign-in (OAuth) pages from apps ask which Chrome profile to use.
  4. Everything else opens in Chrome's Personal profile (not the last-used one).

Calendar-to-profile matching lives in ~/.config/link-router/profiles.conf.
Only https is routed; http stays on Chrome so Omarchy's browser detection is unchanged.
"""

import json
import os
import re
import sqlite3
import sys
from pathlib import Path

HOME = Path.home()
OMACAL_DB = HOME / ".local/share/com.omacal.app/omacal.db"
CALSYNC = HOME / ".cache/cal-sync/events.json"
PROFILES_CONF = HOME / ".config/link-router/profiles.conf"
SIGN_IN = re.compile(
    r"^https://(accounts\.google\.com/(o/oauth2|signin/oauth)|login\.microsoftonline\.com/[^/]+/oauth2"
    r"|login\.live\.com/oauth|([\w-]+\.)?zoom\.us/oauth|slack\.com/oauth"
    r"|[^/?#]+/(.*/)?oauth2?/authorize)",
    re.I,
)


DEFAULT_PROFILE_DIR = "Default"  # Personal: ordinary links open here, not in the last-used profile


def browser(url):
    os.execvp("omarchy-launch-browser",
              ["omarchy-launch-browser", f"--profile-directory={DEFAULT_PROFILE_DIR}", url])


def meeting_key(url):
    """A short, distinctive piece of a meeting link to look for in calendar data."""
    m = re.search(r"zoom\.us/(?:j|w|wc/join|my)/([\w.-]+)", url, re.I)
    if m:
        return "zoom", m.group(1)
    m = re.search(r"meet\.google\.com/([a-z]{3,4}-[a-z]{3,4}-[a-z]{3,4})", url, re.I)
    if m:
        return "meet", m.group(1).lower()
    m = re.search(r"teams\.(?:microsoft|live)\.com/(?:l/meetup-join|meet)/([^?#]{12,})", url, re.I)
    if m:
        return "teams", m.group(1)[:60]
    m = re.search(r"([\w-]+\.webex\.com/[^?#]{6,})", url, re.I)
    if m:
        return "webex", m.group(1)[:60]
    return None, None


def load_rules():
    rules = []
    try:
        for line in PROFILES_CONF.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                match, profile = (p.strip() for p in line.split("=", 1))
                if match and profile:
                    rules.append((match.lower(), profile))
    except OSError:
        pass
    return rules


def profile_for(names, rules):
    """names: the OmaCal account email, account display name and calendar name.
    A rule like "@archway.team" matches an email domain; anything else must equal
    one of the names (case-insensitive). Feed URLs are never matched, since their
    random tokens could contain any short word."""
    names = [n.strip().lower() for n in names if n and n.strip()]
    for match, profile in rules:
        for n in names:
            if (match.startswith("@") and n.endswith(match)) or n == match:
                return profile
    return None


def from_omacal(key):
    """Account email, account name and calendar name of the OmaCal event holding this link."""
    if not OMACAL_DB.exists():
        return None
    try:
        db = sqlite3.connect(f"file:{OMACAL_DB}?mode=ro", uri=True, timeout=1)
        row = db.execute(
            """SELECT COALESCE(a.email,''), COALESCE(a.display_name,''), COALESCE(c.summary,'')
               FROM events e JOIN calendars c ON c.id = e.calendar_id JOIN accounts a ON a.id = c.account_id
               WHERE instr(COALESCE(e.conference_uri,''), ?) OR instr(COALESCE(e.location,''), ?)
                  OR instr(COALESCE(e.description,''), ?)
               ORDER BY e.start_utc DESC LIMIT 1""",
            (key, key, key),
        ).fetchone()
        db.close()
        return list(row) if row else None
    except sqlite3.Error:
        return None


def from_calsync(key):
    try:
        for e in json.loads(CALSYNC.read_text()).get("events", []):
            if key in (e.get("joinUrl") or ""):
                return e.get("profile")
    except (OSError, ValueError):
        pass
    return None


def main():
    url = sys.argv[1] if len(sys.argv) > 1 else ""
    if not url.lower().startswith("https://"):
        return browser(url) if url else None

    # Sign-in pages started by an app (OmaCal, Slack, CLIs): the account depends
    # on the Chrome profile, so ask which one instead of using the last-focused.
    if SIGN_IN.search(url):
        os.execvp("webapp-profile", ["webapp-profile", "pick", url])

    kind, key = meeting_key(url)
    if not kind:
        return browser(url)

    profile = None
    source = from_omacal(key)
    if source:
        profile = profile_for(source, load_rules())
    if not profile:
        profile = from_calsync(key)

    if profile:
        os.execvp("webapp-profile", ["webapp-profile", "join", profile, url])
    if kind == "zoom":
        os.execvp("webapp-profile", ["webapp-profile", "zoom-join", url])
    return browser(url)


if __name__ == "__main__":
    main()
