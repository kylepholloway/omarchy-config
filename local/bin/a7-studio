#!/bin/bash
# Feed the Sony A7 IV's USB stream into the "A7 IV Studio" virtual camera
# (v4l2loopback, /dev/video20), color-correct and with an optional LUT.
#
# Why: Chrome (Zoom/Meet/Teams on the web) picks the camera's MJPG mode, which is
# full-range, and treats it as TV range, crushing shadows into extra contrast.
# Reading the camera's NV12 mode (already TV range) avoids that. A LUT chosen
# with a7-lut (~/.config/a7-studio/luts/, selection in ~/.config/a7-studio/active)
# is applied as a 3D LUT; `a7-lut none` goes back to the straight feed.
#
# Started by udev (a7-studio.service) when the camera connects in USB Streaming mode.
set -euo pipefail

OUT=/dev/video20
LUT_DIR="$HOME/.config/a7-studio"
CAM=$(ls /dev/v4l/by-id/usb-Sony_ILCE-7M4_*-video-index0 2>/dev/null | head -1 || true)
# A7_STUDIO_TEST=1: run the same filters on a test pattern for 5 s, output discarded.
[[ ${A7_STUDIO_TEST:-} == 1 ]] && CAM=test OUT=/dev/null
# No camera (unplugged or not in USB Streaming mode): stop cleanly so systemd does not
# retry; udev starts us again when it reconnects.
[[ -n $CAM ]] || { echo "a7-studio: camera not found (USB Streaming mode on?)" >&2; exit 0; }
[[ -e $OUT || $CAM == test ]] || { echo "a7-studio: $OUT missing (v4l2loopback not loaded)" >&2; exit 1; }

# The active LUT is chosen with a7-lut (a path under luts/ written to "active").
lut=""
if [[ -s $LUT_DIR/active ]]; then
  lut="$LUT_DIR/luts/$(head -1 "$LUT_DIR/active")"
  [[ -f $lut ]] || { echo "a7-studio: active LUT missing, using straight feed" >&2; lut=""; }
fi

# Grade (a7-grade): ~/.config/a7-studio/grade.conf, key=value, all optional.
#   contrast   -5..5  (0 = as camera)      shadows    -5..5 (lift dark tones)
#   highlights -5..5  (pull bright tones)  fade        0..5 (raise pure black)
#   saturation -5..5                       warmth     -5..5 (+ warmer, - cooler)
#   brightness -5..5
declare -A G=([contrast]=0 [shadows]=0 [highlights]=0 [fade]=0 [saturation]=0 [warmth]=0 [brightness]=0)
if [[ -f $LUT_DIR/grade.conf ]]; then
  while IFS='=' read -r k v; do
    k=${k//[[:space:]]/}; v=${v//[[:space:]]/}
    [[ -n ${G[$k]+x} && $v =~ ^-?[0-9]+(\.[0-9]+)?$ ]] && G[$k]=$v
  done < <(grep -v '^\s*#' "$LUT_DIR/grade.conf")
fi
graded=0
for k in "${!G[@]}"; do [[ ${G[$k]} != 0 ]] && graded=1; done

input=(-f v4l2 -input_format nv12 -framerate 30 -video_size 1920x1080 -i "$CAM")
if [[ $CAM == test ]]; then
  input=(-f lavfi -i testsrc2=size=1920x1080:rate=30 -t 5)
  out=(-f null -)
else
  out=(-f v4l2 "$OUT")
fi

if [[ -z $lut && $graded == 0 ]]; then
  # Nothing to do: the camera's NV12 is already TV range, so forward frames untouched (~0% CPU).
  exec ffmpeg -hide_banner -loglevel warning -nostdin "${input[@]}" -c:v copy "${out[@]}"
fi

f() { python3 -c "print(f'{$1:.4f}')"; }
chain="format=gbrp"
if [[ -n $lut ]]; then
  chain+=",lut3d=file='${lut//\'/\\\'}':interp=tetrahedral"
  echo "a7-studio: applying LUT $(basename "$lut")"
fi
if [[ $graded == 1 ]]; then
  # Tone curve: fade lifts black, shadows/highlights bend the quarter points,
  # contrast steepens or flattens around the middle, brightness shifts it all.
  c=${G[contrast]}; b=${G[brightness]}
  y0=$(f "max(0, ${G[fade]}*0.025 + $b*0.01)")
  y1=$(f "min(1,max(0, 0.25 - $c*0.012 + ${G[shadows]}*0.012 + $b*0.015))")
  y2=$(f "min(1,max(0, 0.5 + $b*0.02))")
  y3=$(f "min(1,max(0, 0.75 + $c*0.012 - ${G[highlights]}*0.012 + $b*0.015))")
  y4=$(f "min(1,max(0, 1 - ${G[highlights]}*0.008))")
  chain+=",curves=all='0/$y0 0.25/$y1 0.5/$y2 0.75/$y3 1/$y4'"
  w=$(f "${G[warmth]}*0.03")
  [[ ${G[warmth]} != 0 ]] && chain+=",colorbalance=rm=$w:bm=$(f "-1*$w")"
  echo "a7-studio: grade ${G[*]}"
fi
chain+=",scale=out_range=limited:out_color_matrix=bt709,format=yuv420p"
[[ ${G[saturation]} != 0 ]] && chain+=",hue=s=$(f "1 + ${G[saturation]}*0.08")"

exec ffmpeg -hide_banner -loglevel warning -nostdin "${input[@]}" -vf "$chain" \
  -color_range tv -colorspace bt709 -color_primaries bt709 -color_trc bt709 \
  "${out[@]}"
