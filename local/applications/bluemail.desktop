[Desktop Entry]
Name=BlueMail
GenericName=Mail Client
Comment=Email and calendar for multiple accounts
# Electron picks its password backend from XDG_CURRENT_DESKTOP, does not
# recognise Hyprland, and falls back to no encryption — which stops it saving
# account credentials. Name the backend explicitly, as with Mailspring.
Exec=bluemail --password-store=gnome-libsecret %U
Icon=bluemail
Type=Application
Terminal=false
Categories=Office;Network;Email;
Keywords=email;mail;calendar;
# Must match the packaged entry exactly: this file shadows it by name, so any
# scheme left out here loses its handler. me.blueone.linux is the OAuth
# callback — dropping it breaks Google and Microsoft sign-in.
MimeType=x-scheme-handler/me.blueone.linux;x-scheme-handler/mailto;x-scheme-handler/bluemail-notif;x-scheme-handler/bluemail;
StartupNotify=true
StartupWMClass=BlueMail
